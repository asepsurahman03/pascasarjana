                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Lebih di tingkatkan lagi dari segi media pembelajaran dan pendekatan terhadap mahasiswa</td>
                                </tr>
                                                        <tr>
                            <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="14"> Psikologi Pendidikan (SD25A)</td>
                        </tr>
                        <tr>
                            <td align="center" rowspan="12">#</td>
                                                                                            <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Semoga kedepannya lebih baik lagi</td>
