                            <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="5"> Matematika Bisnis (MN25B)</td>
                        </tr>
                        <tr>
                            <td align="center" rowspan="3">#</td>
                                                                                            <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">no</td>
