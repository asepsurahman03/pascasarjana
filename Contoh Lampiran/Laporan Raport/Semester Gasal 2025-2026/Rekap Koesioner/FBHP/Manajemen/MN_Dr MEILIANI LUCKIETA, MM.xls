                                    </tr>
                                                                        <tr>
                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Baik</td>
                                    </tr>
                                                                        <tr>
                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">tidak ada</td>
                                    </tr>
                                                                        <tr>
                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Terlalu baik dan tidak terlalu menguasai mata kuliah manajemen keuangan</td>
                                    </tr>
