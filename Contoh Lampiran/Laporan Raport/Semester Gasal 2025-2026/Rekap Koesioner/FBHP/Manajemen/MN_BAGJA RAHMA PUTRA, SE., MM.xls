                            <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="20"> Manajemen Keuangan (MN24R)</td>
                        </tr>
                        <tr>
                            <td align="center" rowspan="18">#</td>
                                                                                            <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">semoga lebih rajin lagi ya pak ngajarnya</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Tidak ada</td>
                                </tr>
