                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">lebih baik lagi ga mandang uang</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">tidak ada</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Kadang penjelasannya agak cepat, jadi belum sempat dicatat semua.</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">ga ada yang harus dikritik</td>
                                </tr>
