                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">keren mis</td>
                                    </tr>
                                                                        <tr>
                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">terimakasih sudah membimbing selama satu semester ini buu</td>
                                    </tr>
                                                                        <tr>
                                        <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Terimakasih dan sehat sehat Miss</td>
                                    </tr>
                                                                <tr>
                                <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="7"> Telaah Kurikulum Sekolah Dasar (SD24I)</td>
                            </tr>
                                                            <tr>
