                                                    <tr>
                                <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="7"> Algoritma dan Struktur Data (TI25I)</td>
                            </tr>
                                                            <tr>
                                    <td><b>A</b></td>
