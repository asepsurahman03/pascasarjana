                            <td style="font-weight: bold;padding-left: 5px;padding-right: 5px;" colspan="14"> Sistem Paralel dan Terdistribusi (TI24C)</td>
                        </tr>
                        <tr>
                            <td align="center" rowspan="12">#</td>
                                                                                            <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">-</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">-</td>
