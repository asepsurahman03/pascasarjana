                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">Baik</td>
                                </tr>
                                                                                                    <tr>
                                                                <td style="padding-left: 5px;padding-right: 5px;word-break: break-word">lebih di tingkatkan lagi untuk sesi praktek</td>
                                </tr>
