DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Jika request langsung ke file atau folder fisik nyata, jangan diubah
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Rewrite URL .php langsung (contoh: login -> login.php, mhs/index -> mhs/index.php, pages/raport_dosen -> pages/raport_dosen.php)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]

  # 3. Rewrite jika file berada di dalam subfolder pages/ (contoh: dashboard -> pages/dashboard.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond pages/$1.php -f
  RewriteRule ^(.*)$ pages/$1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
