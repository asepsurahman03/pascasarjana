Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jika request untuk direktori fisik, jangan rewrite
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Jika request untuk file fisik (assets, css, js, images), jangan rewrite
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Jika file .php ada langsung di root (misal /login -> login.php)
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]

  # Dukung akses halaman di dalam folder pages/ secara clean
  RewriteCond %{DOCUMENT_ROOT}/pages/$1\.php -f
  RewriteRule ^(.*)$ pages/$1.php [L,QSA]
</IfModule>

# Security headers (sesuai Aktiftidakaktif)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options SAMEORIGIN
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP settings (sesuai Aktiftidakaktif)
<IfModule mod_php.c>
  php_flag session.cookie_httponly on
  php_flag session.use_strict_mode on
</IfModule>
