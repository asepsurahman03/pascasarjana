DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Jika request mengarah ke file atau folder fisik nyata (css, js, gambar), lewati rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Jika file .php ada di root (contoh: /login -> login.php, /logout -> logout.php)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

  # 3. Jika file .php ada di dalam folder pages (contoh: /raport_dosen -> pages/raport_dosen.php)
  RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
  RewriteRule ^([^/]+)/?$ pages/$1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
